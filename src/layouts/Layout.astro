---
import '../styles/global.css';
import { BLOCKS } from '../lib/blocks';
import { CITATION, DOI, DOI_URL, LICENSE } from '../lib/site';

const { title, description } = Astro.props as { title: string; description?: string };
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/methodology', label: 'Методологія' },
  { href: '/data', label: 'Дані й цитування' },
  { href: '/about', label: 'Про проєкт' },
];
const inResults = BLOCKS.some((b) => path.startsWith(b.href));
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="topnav">
      <a href="/" class="brand">Науковий Барометр</a>
      <nav aria-label="Основна навігація">
        <a href="/" class={active('/') ? 'active' : ''}>Головна</a>
        <div class="navgroup">
          <a href="/#rozdily" class={inResults ? 'active' : ''} aria-haspopup="true">Результати <span aria-hidden="true">▾</span></a>
          <div class="navmenu">
            {BLOCKS.map((b, i) => (
              <a href={b.href} class={path.startsWith(b.href) ? 'active' : ''}><span class="bn-num">{i + 1}</span>{b.title}</a>
            ))}
          </div>
        </div>
        {nav.map((n) => <a href={n.href} class={active(n.href) ? 'active' : ''}>{n.label}</a>)}
        <a href="/participate" class={`cta${active('/participate') ? ' active' : ''}`}>Долучитися</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>
        Дані публікуються <b>лише агреговано й безособово</b>. Набір даних хвилі 2026 — на Zenodo,
        DOI <a href={DOI_URL} target="_blank" rel="noopener">{DOI}</a>, ліцензія <a href={LICENSE.url} target="_blank" rel="noopener">{LICENSE.name}</a>.
      </p>
      <p class="cite">Як цитувати: {CITATION}</p>
      <p>
        <a href="/participate">Долучитися до наступної хвилі</a> · Науковий Барометр / Scientists Barometer
      </p>
    </footer>
  </body>
</html>
