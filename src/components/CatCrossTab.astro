---
// Теплокарта розрізів «Категоризації»: рядки = види (сортовані), колонки = групи демографії.
// Клітинка несе всі три показники (ДНД / КННД / БД) з 95 % ДІ Вілсона; видно той, що обрано
// селектором «Сортувати» (за замовч. БД): скрипт сторінки змінює лише data-metric контейнера,
// числа й кольори всіх трьох уже відрендерені на збірці. Селектор демографії — CSS-only.
// Придушення n<5 → «·».
import CtFoot from './CtFoot.astro';
import ciData from '../data/crosstab-ci-2026.json';
import { ciText, SMALL_N, type CI } from '../lib/crosstab';
import { range, int } from '../lib/format';

interface Act { name: string; nd: number; kn: number; bd: number; pi: number; }
interface Cell { nd: number; kn: number; bd: number; }
interface Group { value: string; n: number; }
interface Dim { id: string; label: string; groups: Group[]; }
const { block } = Astro.props as {
  block: {
    activities: Act[];
    crosstabDims: Dim[];
    crosstab: Record<string, Record<string, { n: number; cells: Record<string, Cell | null> }>>;
  };
};
type CiCell = { n: number; nd: CI; kn: CI; bd: CI } | null;
const CIS = ciData.categorization as unknown as Record<string, Record<string, Record<string, CiCell>>>;
const acts = block.activities;
const alpha = (p: number) => Math.min(p / 70, 1) * 0.85;
const KEYS = [['nd', 'ДНД'], ['kn', 'КННД'], ['bd', 'БД']] as const;
const title = (c: Cell, ci: CiCell) =>
  KEYS.map(([k, l]) => `${l} ${c[k]} %${ci ? ` (${range(ci[k][0], ci[k][1], 0)})` : ''}`).join(' · ') +
  (ci ? `; 95 % ДІ у дужках, n = ${int(ci.n)}` : '');
---

<div class="crosstab" data-metric="bd" data-metric-root="cat">
  {block.crosstabDims.map((d, i) => (
    <input type="radio" class="ct-r" name="ct-dim" id={`ct-${d.id}`} checked={i === 0} />
  ))}
  <input type="checkbox" class="ct-cib" id="ct-cat-ci" />
  <div class="ct-tabs">
    {block.crosstabDims.map((d) => (
      <label for={`ct-${d.id}`}>{d.label}</label>
    ))}
  </div>
  <label class="ct-cilabel" for="ct-cat-ci">Показати 95&nbsp;% ДІ</label>

  {block.crosstabDims.map((d) => (
    <div class="ct-pane" data-dim={d.id}>
      <div class="ct-scroll">
        <table class="ct-table">
          <thead>
            <tr>
              <th>Вид діяльності · %</th>
              {d.groups.map((g) => (
                <th class={g.n < SMALL_N ? 'lown' : ''}>{g.value}<br /><span class="ct-n">n={g.n}</span></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {acts.map((a) => (
              <tr data-nd={a.nd} data-kn={a.kn} data-bd={a.bd} data-pi={a.pi}>
                <td>{a.name}</td>
                {d.groups.map((g) => {
                  const c = block.crosstab[d.id][g.value].cells[a.name];
                  if (!c) return <td class="ct-cell none">·</td>;
                  const ci = CIS[d.id]?.[g.value]?.[a.name] ?? null;
                  const vars = KEYS.map(([k]) => `--a-${k}:${alpha(c[k]).toFixed(2)}`).join(';');
                  const hi = KEYS.filter(([k]) => alpha(c[k]) > 0.45).map(([k]) => ` hi-${k}`).join('');
                  return (
                    <td class={`ct-cell mcell${hi}${ci && ci.n < SMALL_N ? ' lown' : ''}`} style={vars} title={title(c, ci)}>
                      {KEYS.map(([k]) => (
                        <span class={`m m-${k}`}>{c[k]}<span class="ct-ci">{ciText(ci?.[k])}</span></span>
                      ))}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <CtFoot cube={CIS}>
        Числа — % у групі для <b>обраної категорії</b> (селектор «Сортувати»):
        <span class="t-good">ДНД</span> / <span class="t-neutral">КННД</span> / <span class="t-bad">БД</span>; темніше — вищий %.
      </CtFoot>
    </div>
  ))}
</div>
