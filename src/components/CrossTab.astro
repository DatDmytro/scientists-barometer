---
// Теплокарта розрізів «Мотивації»: рядки = варіанти мети, колонки = групи обраної демографії,
// клітинка = % у групі, хто обрав варіант (+ 95 % ДІ Вілсона). Селектор демографії — CSS-only.
// Групи з n<5 вже придушено в даних.
import CtFoot from './CtFoot.astro';
import ciData from '../data/crosstab-ci-2026.json';
import { tip, ciText, SMALL_N, type CI } from '../lib/crosstab';
import { pct } from '../lib/format';

interface Opt { code: string; label: string; pct: number; }
interface Group { value: string; n: number; }
interface Dim { id: string; label: string; groups: Group[]; }
const { block } = Astro.props as {
  block: {
    options: Opt[];
    dimensions: Dim[];
    crosstab: Record<string, Record<string, { n: number; pct: Record<string, number> }>>;
  };
};
const CIS = ciData.motivation as Record<string, Record<string, Record<string, { n: number; ci: CI }>>>;
const opts = block.options;
const alpha = (p: number) => Math.min(p / 55, 1) * 0.82; // шкала кольору 0–55%+
---

<div class="crosstab">
  {block.dimensions.map((d, i) => (
    <input type="radio" class="ct-r" name="ct-dim" id={`ct-${d.id}`} checked={i === 0} />
  ))}
  <input type="checkbox" class="ct-cib" id="ct-mot-ci" />
  <div class="ct-tabs">
    {block.dimensions.map((d) => (
      <label for={`ct-${d.id}`}>{d.label}</label>
    ))}
  </div>
  <label class="ct-cilabel" for="ct-mot-ci">Показати 95&nbsp;% ДІ</label>

  {block.dimensions.map((d) => (
    <div class="ct-pane" data-dim={d.id}>
      <div class="ct-scroll">
        <table class="ct-table">
          <thead>
            <tr>
              <th>Мета \ {d.label.toLowerCase()}</th>
              {d.groups.map((g) => (
                <th class={g.n < SMALL_N ? 'lown' : ''}>{g.value}<br /><span class="ct-n">n={g.n}</span></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {opts.map((o) => (
              <tr>
                <td>{o.label}</td>
                {d.groups.map((g) => {
                  const p = block.crosstab[d.id][g.value].pct[o.label] ?? 0;
                  const c = CIS[d.id]?.[g.value]?.[o.label];
                  const a = alpha(p);
                  return (
                    <td class={`ct-cell${a > 0.45 ? ' hi' : ''}${g.n < SMALL_N ? ' lown' : ''}`} style={`--a:${a.toFixed(2)}`}
                        title={tip(pct(p), c?.ci, c?.n)}>
                      {p.toFixed(0)}<span class="ct-ci">{ciText(c?.ci)}</span>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <CtFoot cube={CIS}>
        Числа — % респондентів у групі, хто обрав варіант (множинний вибір, тож сума &gt; 100&nbsp;%).
      </CtFoot>
    </div>
  ))}
</div>
