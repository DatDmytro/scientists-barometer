---
// Шапка сторінки блоку: смуга блоків, заголовок і підводка — дослівне питання анкети
// (у лапках) або тема блоку (без лапок, бо єдиного формулювання немає).
import BlockNav from './BlockNav.astro';
import { blockBySlug } from '../lib/blocks';

interface Props { slug: string; title?: string }
const { slug, title } = Astro.props;
const b = blockBySlug(slug);
---

<BlockNav slug={slug} />
<h1>{title ?? b.title}</h1>
{b.lead.kind === 'question'
  ? <p class="lead">«{b.lead.text}»</p>
  : <p class="lead topic">Тема блоку: <b>{b.lead.text}</b></p>}
