---
// Плитка «Структура робочого часу» для головних показників: три середні частки тижня
// (ДНД / КННД / БД) — не індекс, тож без шкали 0–200; стек-смуга і години безглуздої діяльності.
import time from '../data/block-timestructure-2026.json';
import { num, pct } from '../lib/format';

const share = Object.fromEntries(time.shares.map((s) => [s.cat, s.mean]));
const ROWS = [
  { cat: 'НД', cls: 'nd', sw: 'swnd', label: 'Дійсна наукова' },
  { cat: 'КН', cls: 'kn', sw: 'swkn', label: 'Корисна ненаукова' },
  { cat: 'БД', cls: 'bd', sw: 'swbd', label: 'Безглузда' },
];
---

<article class="tile">
  <p class="tile-kind">Стан зараз · частки робочого тижня</p>
  <h3 class="tile-title">Структура робочого часу</h3>
  <p class="tile-what">на що йде робочий тиждень, за самооцінкою респондентів</p>

  <ul class="tt-list">
    {ROWS.map((r) => (
      <li><i class={`tt-sw ${r.sw}`}></i><span>{r.label}</span><b>{pct(share[r.cat])}</b></li>
    ))}
  </ul>
  <div class="actbar tt-bar" role="img"
       aria-label={ROWS.map((r) => `${r.label} ${pct(share[r.cat])}`).join(', ')}>
    {ROWS.map((r) => <span class={r.cls} style={`width:${share[r.cat]}%`}></span>)}
  </div>

  <p class="tile-verdict">≈ {num(time.hours.bullshitHoursAtMean)} год на тиждень — безглузда діяльність</p>
  <p class="tile-meta">за середнього робочого тижня {num(time.hours.mean)} год</p>

  <a class="tile-link" href="/time-structure">Докладніше →</a>
</article>
