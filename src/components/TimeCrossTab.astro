---
// Теплокарта: рядки = категорії часу (НД/КН/БД), колонки = групи демографії,
// клітинка = середня частка часу (%) групи на категорію (+ 95 % ДІ середнього).
// Колір рядка = колір категорії. Селектор демографії — CSS-only. Придушення n<5 → «·». Zero-JS.
import CtFoot from './CtFoot.astro';
import ciData from '../data/crosstab-ci-2026.json';
import { tip, ciText, SMALL_N, type CI } from '../lib/crosstab';
import { pct } from '../lib/format';

interface Group { value: string; n: number; }
interface Dim { id: string; label: string; groups: Group[]; }
const { block } = Astro.props as {
  block: {
    crosstabDims: Dim[];
    crosstab: Record<string, Record<string, { n: number } & Record<string, number | null>>>;
  };
};
const CIS = ciData.timestructure as Record<string, Record<string, Record<string, { n: number; ci: CI } | null>>>;
const rows = [
  { cat: 'НД', label: 'Дійсна наукова', color: 'c-good' },
  { cat: 'КН', label: 'Корисна ненаукова', color: 'c-neutral' },
  { cat: 'БД', label: 'Безглузда', color: 'c-bad' },
];
const alpha = (p: number) => Math.min(p / 50, 1) * 0.85;
---

<div class="crosstab">
  {block.crosstabDims.map((d, i) => (
    <input type="radio" class="ct-r" name="ct-dim" id={`ct-${d.id}`} checked={i === 0} />
  ))}
  <input type="checkbox" class="ct-cib" id="ct-time-ci" />
  <div class="ct-tabs">
    {block.crosstabDims.map((d) => (
      <label for={`ct-${d.id}`}>{d.label}</label>
    ))}
  </div>
  <label class="ct-cilabel" for="ct-time-ci">Показати 95&nbsp;% ДІ</label>

  {block.crosstabDims.map((d) => (
    <div class="ct-pane" data-dim={d.id}>
      <div class="ct-scroll">
        <table class="ct-table">
          <thead>
            <tr>
              <th>Частка часу · %</th>
              {d.groups.map((g) => (
                <th class={g.n < SMALL_N ? 'lown' : ''}>{g.value}<br /><span class="ct-n">n={g.n}</span></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>{r.label} ({r.cat})</td>
                {d.groups.map((g) => {
                  const v = block.crosstab[d.id][g.value][r.cat];
                  if (v === null || v === undefined) {
                    return <td class="ct-cell none">·</td>;
                  }
                  const c = CIS[d.id]?.[g.value]?.[r.cat];
                  const a = alpha(v);
                  return (
                    <td class={`ct-cell ${r.color}${a > 0.45 ? ' hi' : ''}${c && c.n < SMALL_N ? ' lown' : ''}`} style={`--a:${a.toFixed(2)}`}
                        title={tip(pct(v), c?.ci, c?.n, 1)}>
                      {Math.round(v)}<span class="ct-ci">{ciText(c?.ci)}</span>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <CtFoot cube={CIS}>Числа — середня частка робочого часу (%) групи на категорію.</CtFoot>
    </div>
  ))}
</div>
