---
// Дзеркальна гістограма двох груп відповідей на одне питання з однаковими інтервалами:
// ліворуч — перша група, праворуч — друга, рядки — інтервали, довжина — % своєї групи
// (кожна група — від своєї бази, тож різні n не спотворюють порівняння).
// Використання: ЗВО ↔ НУ на «Структурі часу» (verification → knownGroups).
import { pct } from '../lib/format';

interface Bin { label: string; left: number; right: number } // кількості відповідей
interface Side { label: string; n: number }
interface Props {
  bins: Bin[];
  left: Side;
  right: Side;
  title?: string;
  sub?: string; // рядок під заголовком (напр. результат критерію)
  head?: [string, string]; // підписи над стовпцями; за замовч. — назви груп
  foot?: string;
  tone: string;
  wide?: boolean;
}
const { bins, left, right, title, sub, head, foot, tone, wide = false } = Astro.props;
const lp = bins.map((b) => (b.left / left.n) * 100);
const rp = bins.map((b) => (b.right / right.n) * 100);
const max = Math.max(...lp, ...rp);
const short = (s: string) => s.replace(/\s?%$/, '');
---

<figure class={`mirror${wide ? ' wide' : ''}`}>
  {(title || sub) && (
    <figcaption>
      {title && <b>{title}</b>}
      {sub && <span class="note">{sub}</span>}
    </figcaption>
  )}
  <div class="mh-head"><span>{head?.[0] ?? left.label}</span><span></span><span>{head?.[1] ?? right.label}</span></div>
  {bins.map((b, k) => (
    <div class="mh-row" title={`${b.label}: ${left.label} ${pct(lp[k])} (${b.left}), ${right.label} ${pct(rp[k])} (${b.right})`}>
      <span class="mh-l"><i class={`t-${tone}`} style={`width:${(lp[k] / max) * 100}%`}></i></span>
      <span class="mh-x">{short(b.label)}</span>
      <span class="mh-r"><i class={`t-${tone}`} style={`width:${(rp[k] / max) * 100}%`}></i></span>
    </div>
  ))}
  {foot && <p class="note mh-foot">{foot}</p>}
</figure>
