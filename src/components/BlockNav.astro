---
// Навігація між шістьма блоками: пронумерована смуга вгорі, «назад / далі» внизу.
import { blocksFor } from '../lib/blocks';
import { i18n } from '../i18n';

interface Props { slug: string; where?: 'top' | 'bottom' }
const { slug, where = 'top' } = Astro.props;
const { lang, en, link } = i18n(Astro);
const BLOCKS = blocksFor(lang);
const k = BLOCKS.findIndex((b) => b.slug === slug);
const prev = BLOCKS[k - 1];
const next = BLOCKS[k + 1];
---

{where === 'top' ? (
  <nav class="blocknav" aria-label={en ? 'Survey blocks' : 'Блоки опитування'}>
    {BLOCKS.map((b, i) => (
      <a href={b.href} class={i === k ? 'active' : ''} aria-current={i === k ? 'page' : undefined}>
        <span class="bn-num">{i + 1}</span>{b.title}
      </a>
    ))}
  </nav>
) : (
  <nav class="blockpager" aria-label={en ? 'Neighbouring blocks' : 'Сусідні блоки'}>
    {prev ? <a href={prev.href}>← {k}. {prev.title}</a> : <a href={link('/#rozdily')}>{en ? '← All sections' : '← Усі розділи'}</a>}
    {next ? <a href={next.href} class="next">{k + 2}. {next.title} →</a> : <a href={link('/#rozdily')} class="next">{en ? 'All sections →' : 'Усі розділи →'}</a>}
  </nav>
)}
