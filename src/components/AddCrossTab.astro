---
// Теплокарта: рядки = 3 показники (зниження навантаж./усунення БД/публікації),
// колонки = групи демографії, клітинка = % позитивних у групі (+ 95 % ДІ Вілсона).
// Синя шкала (вище = сильніша згода). Селектор демографії — CSS-only. Придушення n<5 → «·». Zero-JS.
import CtFoot from './CtFoot.astro';
import ciData from '../data/crosstab-ci-2026.json';
import { SMALL_N, type CI } from '../lib/crosstab';
import { i18n } from '../i18n';

const { en, tr, pct, tip, ciText } = i18n(Astro);

interface Group { value: string; n: number; }
interface Dim { id: string; label: string; groups: Group[]; }
interface Ind { code: string; label: string; }
const { block } = Astro.props as {
  block: {
    indicatorLabels: Ind[];
    crosstabDims: Dim[];
    crosstab: Record<string, Record<string, { n: number } & Record<string, number | null>>>;
  };
};
const CIS = ciData.additional as Record<string, Record<string, Record<string, { n: number; ci: CI } | null>>>;
const rows = block.indicatorLabels;
const alpha = (p: number) => Math.min(p / 100, 1) * 0.9;
---

<div class="crosstab">
  {block.crosstabDims.map((d, i) => (
    <input type="radio" class="ct-r" name="ct-dim" id={`ct-${d.id}`} checked={i === 0} />
  ))}
  <input type="checkbox" class="ct-cib" id="ct-add-ci" />
  <div class="ct-tabs">
    {block.crosstabDims.map((d) => (
      <label for={`ct-${d.id}`}>{tr(d.label)}</label>
    ))}
  </div>
  <label class="ct-cilabel" for="ct-add-ci">{en ? <>Show 95% CI</> : <>Показати 95&nbsp;% ДІ</>}</label>

  {block.crosstabDims.map((d) => (
    <div class="ct-pane" data-dim={d.id}>
      <div class="ct-scroll">
        <table class="ct-table">
          <thead>
            <tr>
              <th>{en ? 'Indicator · % agreeing' : 'Показник · % згодних'}</th>
              {d.groups.map((g) => (
                <th class={g.n < SMALL_N ? 'lown' : ''}>{tr(g.value)}<br /><span class="ct-n">n={g.n}</span></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>{tr(r.label)}</td>
                {d.groups.map((g) => {
                  const v = block.crosstab[d.id][g.value][r.code];
                  if (v === null || v === undefined) {
                    return <td class="ct-cell none">·</td>;
                  }
                  const c = CIS[d.id]?.[g.value]?.[r.code];
                  const a = alpha(v);
                  return (
                    <td class={`ct-cell c-good${a > 0.45 ? ' hi' : ''}${c && c.n < SMALL_N ? ' lown' : ''}`} style={`--a:${a.toFixed(2)}`}
                        title={tip(pct(v, 0), c?.ci, c?.n)}>
                      {Math.round(v)}<span class="ct-ci">{ciText(c?.ci)}</span>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <CtFoot cube={CIS}>{en ? <>Figures: % in the group who agree (the two most positive responses); darker means stronger agreement.</> : <>Числа — % у групі, хто згоден (дві найпозитивніші відповіді); темніше — сильніша згода.</>}</CtFoot>
    </div>
  ))}
</div>
