---
import Layout from '../layouts/Layout.astro';
import BlockHeader from '../components/BlockHeader.astro';
import BlockNav from '../components/BlockNav.astro';
import IndexForest from '../components/IndexForest.astro';
import DistTable from '../components/DistTable.astro';
import ResCrossTab from '../components/ResCrossTab.astro';
import SuffCrossTab from '../components/SuffCrossTab.astro';
import block from '../data/block-resources-2026.json';
import { indexApi } from '../lib/indices';
import { i18n } from '../i18n';

const { lang, en, tr, num, pct } = i18n(Astro);
const { byCode, CHANGE_CAVEAT } = indexApi(lang);

const STATE = [{ codes: ['ІНМ ф', 'ІНМ о', 'ІНМ ч', 'ІНМ'] }];
const CHANGE = [
  { title: (en ? 'Adequacy of funding' : 'Забезпеченість фінансуванням'), codes: ['ІНМ ф1', 'ІНМ ф5'] },
  { title: (en ? 'Adequacy of equipment' : 'Забезпеченість обладнанням'), codes: ['ІНМ о1', 'ІНМ о5'] },
  { title: (en ? 'Adequacy of time' : 'Забезпеченість часом'), codes: ['ІНМ ч1', 'ІНМ ч5'] },
];
const changeIdx = CHANGE.flatMap((g) => g.codes).map(byCode);
const below = changeIdx.filter((i) => !i.crosses100 && i.value < 100);
const nsIdx = changeIdx.filter((i) => i.crosses100);
const inm = byCode('ІНМ');
const w = block.war;
---

<Layout
  title={en ? 'Adequacy of resources — Scientists Barometer' : 'Забезпеченість ресурсами — Науковий Барометр'}
  description={en ? 'How well researchers are provided with funding, equipment and time; lack of sleep and rest; working time lost because of the war.' : 'Наскільки науковці забезпечені фінансуванням, обладнанням і часом; нестача сну й відпочинку; втрати робочого часу через війну.'}
>
  <BlockHeader slug="resources" />

  <section>
    <h2>{en ? 'Current adequacy' : 'Поточна забезпеченість'}</h2>
    <div class="cat-summary">
      <div><b>{num(inm.value)}</b>{en ? ' Research Capacity Index (RCI; 100 is the neutral value)' : ' Індекс наукових можливостей (ІНМ; 100 — нейтральне значення)'}</div>
      <div><b>{pct(block.provision[0].unprovidedPct)}</b>{en ? <> have inadequate funding ({pct(block.provision[0].criticalPct)} critically)</> : <> незабезпечені фінансуванням ({pct(block.provision[0].criticalPct)} — критично)</>}</div>
    </div>
    <IndexForest groups={STATE} />
    <div class="table-scroll"><table>
      <thead><tr><th>{en ? 'Resource' : 'Ресурс'}</th><th class="num">{en ? 'Index' : 'Індекс'}</th><th class="num">{en ? 'Inadequate, %' : 'Незабезпечені, %'}</th><th class="num">{en ? 'of which critically' : 'з них критично'}</th></tr></thead>
      <tbody>
        {block.provision.map((p) => (
          <tr>
            <td>{tr(p.label)}</td>
            <td class="num"><b>{num(p.index)}</b></td>
            <td class="num">{num(p.unprovidedPct)}</td>
            <td class="num">{num(p.criticalPct)}</td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <DistTable codes={['ІНМ ф', 'ІНМ о', 'ІНМ ч']} caption={en ? 'Response distribution, %' : 'Розподіл відповідей, %'} />
  </section>

  <section>
    <h2>{en ? 'Assessed change in adequacy' : 'Оцінка змін забезпеченості'}</h2>
    <p class="note" style="margin-top:-0.2rem">
      {en ? 'How, in respondents’ view, adequacy has changed over 1 year and 5 years.' : 'Як, на думку респондентів, змінилася забезпеченість за рік і за 5 років.'}
      {CHANGE_CAVEAT}
    </p>
    <IndexForest groups={CHANGE} />
    <p class="note">
      {en ? <>{below.length} of {changeIdx.length} assessed changes are below 100 and differ from the neutral value: in
      respondents’ assessment, adequacy has deteriorated.
      {nsIdx.length > 0 && <>
        The exception is {nsIdx.map((i) => `${i.subject.toLowerCase()} ${i.horizonText} (${i.verdict})`).join(', ')}:
        the interval crosses 100.
      </>}</> : <>{below.length} із {changeIdx.length} оцінок змін нижчі за 100 і від нейтрального значення відрізняються: за оцінкою
      респондентів, забезпеченість погіршувалася.
      {nsIdx.length > 0 && <>
        Виняток — {nsIdx.map((i) => `${i.subject.toLowerCase()} ${i.horizonText} (${i.verdict})`).join(', ')}:
        інтервал перетинає 100.
      </>}</>}
    </p>
    <DistTable codes={CHANGE.flatMap((g) => g.codes)} caption={en ? 'Response distribution, %' : 'Розподіл відповідей, %'} />
  </section>

  <section>
    <h2>{en ? 'Sufficiency of time' : 'Достатність часу'}</h2>
    <div class="catsort">
      {en ? 'Show:' : 'Показати:'}
      <select id="suf-metric">
        <option value="insuf">{en ? 'for whom it is insufficient (in red)' : 'кому недостатньо (червоним)'}</option>
        <option value="suf">{en ? 'for whom it is sufficient (in blue)' : 'кому достатньо (синім)'}</option>
      </select>
    </div>
    <table class="dist">
      <tbody>
        {block.sufficiency.map((s) => (
          <tr>
            <td class="opt">{tr(s.label)}</td>
            <td class="barcell"><div class="bar"><span class="sufbar t-bad" data-insuf={s.insufficientPct} data-suf={s.sufficientPct} style={`width:${s.insufficientPct}%`}></span></div></td>
            <td class="pct sufpct" data-insuf={pct(s.insufficientPct)} data-suf={pct(s.sufficientPct)}>{pct(s.insufficientPct)}</td>
            <td class="nn">{en ? 'critically insufficient' : 'крит. недост.'} {pct(s.criticalPct)}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 style="font-size:0.96rem;margin:1.4rem 0 0.3rem;color:var(--ink)">{en ? 'Demographic breakdowns' : 'Розрізи за демографією'}</h3>
    <p class="note" style="margin-top:0">{en ? 'The same metric (insufficient / sufficient), by group.' : 'Та сама метрика (недостатньо / достатньо) у розрізі груп.'}</p>
    <SuffCrossTab block={block} />
  </section>

  <section>
    <h2>{en ? 'Working time lost because of the war' : 'Втрати робочого часу через війну'}</h2>
    <div class="cat-summary">
      <div><b>{pct(w.meanPct)}</b>{en ? <> of working time is lost on average to shelling, air raid alerts and power cuts (median {pct(w.medianPct)})</> : <> робочого часу в середньому втрачається через обстріли, тривоги, відключення (медіана {pct(w.medianPct)})</>}</div>
    </div>
  </section>

  <section>
    <h2>{en ? 'Demographic breakdowns' : 'Розрізи за демографією'}</h2>
    <div class="catsort">
      {en ? 'Show:' : 'Показати:'}
      <select id="prov-metric">
        <option value="unprov">{en ? 'with inadequate provision (in red)' : 'хто незабезпечений (червоним)'}</option>
        <option value="prov">{en ? 'with adequate provision (in blue)' : 'хто забезпечений (синім)'}</option>
      </select>
    </div>
    <p class="note" style="margin-top:0">{en ? '% in the group for the chosen metric, for each resource.' : '% у групі для обраної метрики, по кожному ресурсу.'}</p>
    <ResCrossTab block={block} />
  </section>

  <section>
    <h2>{en ? 'Comments on this block' : 'Коментарі до блоку'} ({block.comments.length})</h2>
    <p class="note">{en ? 'Respondents’ open comments on this section of the questionnaire, in English translation. The originals are in the Ukrainian version of this page.' : 'Відкриті коментарі респондентів до цього розділу анкети — дослівно, без редагування.'}</p>
    <ul class="qlist comments">
      {block.comments.map((c) => <li>{tr(c)}</li>)}
    </ul>
  </section>

  <BlockNav slug="resources" where="bottom" />
</Layout>

<script>
  // Достатність часу: «недостатньо» ⇄ «достатньо» — бари й підписи; теплокарти розрізів
  // уже містять обидва показники, тож для них перемикаємо лише data-metric контейнера.
  const setMetric = (root: string, metric: string) =>
    document.querySelectorAll<HTMLElement>(`[data-metric-root="${root}"]`).forEach((el) => (el.dataset.metric = metric));

  const suf = document.getElementById('suf-metric') as HTMLSelectElement | null;
  suf?.addEventListener('change', () => {
    const m = suf.value;
    document.querySelectorAll<HTMLElement>('.sufbar').forEach((bar) => {
      bar.style.width = (bar.dataset[m] || '0') + '%';
      bar.classList.toggle('t-bad', m === 'insuf');
      bar.classList.toggle('t-good', m === 'suf');
    });
    document.querySelectorAll<HTMLElement>('.sufpct').forEach((p) => (p.textContent = p.dataset[m] || ''));
    setMetric('suf', m);
  });

  const prov = document.getElementById('prov-metric') as HTMLSelectElement | null;
  prov?.addEventListener('change', () => setMetric('prov', prov.value));
</script>
