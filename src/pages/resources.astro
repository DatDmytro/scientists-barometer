---
import Layout from '../layouts/Layout.astro';
import BlockHeader from '../components/BlockHeader.astro';
import BlockNav from '../components/BlockNav.astro';
import IndexForest from '../components/IndexForest.astro';
import DistTable from '../components/DistTable.astro';
import ResCrossTab from '../components/ResCrossTab.astro';
import SuffCrossTab from '../components/SuffCrossTab.astro';
import block from '../data/block-resources-2026.json';
import { byCode, CHANGE_CAVEAT } from '../lib/indices';
import { num, pct } from '../lib/format';

const STATE = [{ codes: ['ІНМ ф', 'ІНМ о', 'ІНМ ч', 'ІНМ'] }];
const CHANGE = [
  { title: 'Забезпеченість фінансуванням', codes: ['ІНМ ф1', 'ІНМ ф5'] },
  { title: 'Забезпеченість обладнанням', codes: ['ІНМ о1', 'ІНМ о5'] },
  { title: 'Забезпеченість часом', codes: ['ІНМ ч1', 'ІНМ ч5'] },
];
const changeIdx = CHANGE.flatMap((g) => g.codes).map(byCode);
const below = changeIdx.filter((i) => !i.crosses100 && i.value < 100);
const nsIdx = changeIdx.filter((i) => i.crosses100);
const inm = byCode('ІНМ');
const w = block.war;
---

<Layout
  title="Забезпеченість ресурсами — Науковий Барометр"
  description="Наскільки науковці забезпечені фінансуванням, обладнанням і часом; нестача сну й відпочинку; втрати через війну."
>
  <BlockHeader slug="resources" />

  <section>
    <h2>Поточна забезпеченість</h2>
    <div class="cat-summary">
      <div><b>{num(inm.value)}</b> Індекс наукових можливостей (ІНМ; 100 — нейтральне значення)</div>
      <div><b>{pct(block.provision[0].unprovidedPct)}</b> незабезпечені фінансуванням ({pct(block.provision[0].criticalPct)} — критично)</div>
    </div>
    <IndexForest groups={STATE} />
    <div class="table-scroll"><table>
      <thead><tr><th>Ресурс</th><th class="num">Індекс</th><th class="num">Незабезпечені, %</th><th class="num">з них критично</th></tr></thead>
      <tbody>
        {block.provision.map((p) => (
          <tr>
            <td>{p.label}</td>
            <td class="num"><b>{num(p.index)}</b></td>
            <td class="num">{num(p.unprovidedPct)}</td>
            <td class="num">{num(p.criticalPct)}</td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <DistTable codes={['ІНМ ф', 'ІНМ о', 'ІНМ ч']} caption="Розподіл відповідей, %" />
  </section>

  <section>
    <h2>Оцінка змін забезпеченості</h2>
    <p class="note" style="margin-top:-0.2rem">
      Як, на думку респондентів, змінилася забезпеченість за рік і за 5 років.
      {CHANGE_CAVEAT}
    </p>
    <IndexForest groups={CHANGE} />
    <p class="note">
      {below.length} із {changeIdx.length} оцінок змін нижчі за 100 і від нейтрального значення відрізняються: за оцінкою
      респондентів, забезпеченість погіршувалася.
      {nsIdx.length > 0 && <>
        Виняток — {nsIdx.map((i) => `${i.subject.toLowerCase()} ${i.horizonText} (${i.verdict})`).join(', ')}:
        інтервал перетинає 100.
      </>}
    </p>
    <DistTable codes={CHANGE.flatMap((g) => g.codes)} caption="Розподіл відповідей, %" />
  </section>

  <section>
    <h2>Достатність часу</h2>
    <div class="catsort">
      Показати:
      <select id="suf-metric">
        <option value="insuf">кому недостатньо (червоним)</option>
        <option value="suf">кому достатньо (синім)</option>
      </select>
    </div>
    <table class="dist">
      <tbody>
        {block.sufficiency.map((s) => (
          <tr>
            <td class="opt">{s.label}</td>
            <td class="barcell"><div class="bar"><span class="sufbar t-bad" data-insuf={s.insufficientPct} data-suf={s.sufficientPct} style={`width:${s.insufficientPct}%`}></span></div></td>
            <td class="pct sufpct" data-insuf={pct(s.insufficientPct)} data-suf={pct(s.sufficientPct)}>{pct(s.insufficientPct)}</td>
            <td class="nn">крит. недост. {pct(s.criticalPct)}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 style="font-size:0.96rem;margin:1.4rem 0 0.3rem;color:var(--ink)">Розрізи за демографією</h3>
    <p class="note" style="margin-top:0">Та сама метрика (недостатньо / достатньо) у розрізі груп.</p>
    <SuffCrossTab block={block} />
  </section>

  <section>
    <h2>Втрати через війну</h2>
    <div class="cat-summary">
      <div><b>{pct(w.meanPct)}</b> робочого часу в середньому втрачається через обстріли, тривоги, відключення (медіана {pct(w.medianPct)})</div>
    </div>
  </section>

  <section>
    <h2>Розрізи за демографією</h2>
    <div class="catsort">
      Показати:
      <select id="prov-metric">
        <option value="unprov">хто незабезпечений (червоним)</option>
        <option value="prov">хто забезпечений (синім)</option>
      </select>
    </div>
    <p class="note" style="margin-top:0">% у групі для обраної метрики, по кожному ресурсу.</p>
    <ResCrossTab block={block} />
  </section>

  <section>
    <h2>Коментарі до блоку ({block.comments.length})</h2>
    <p class="note">Відкриті коментарі респондентів до цього розділу анкети — дослівно, без редагування.</p>
    <ul class="qlist comments">
      {block.comments.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <BlockNav slug="resources" where="bottom" />
</Layout>

<script>
  // Достатність часу: «недостатньо» ⇄ «достатньо» — бари й підписи; теплокарти розрізів
  // уже містять обидва показники, тож для них перемикаємо лише data-metric контейнера.
  const setMetric = (root: string, metric: string) =>
    document.querySelectorAll<HTMLElement>(`[data-metric-root="${root}"]`).forEach((el) => (el.dataset.metric = metric));

  const suf = document.getElementById('suf-metric') as HTMLSelectElement | null;
  suf?.addEventListener('change', () => {
    const m = suf.value;
    document.querySelectorAll<HTMLElement>('.sufbar').forEach((bar) => {
      bar.style.width = (bar.dataset[m] || '0') + '%';
      bar.classList.toggle('t-bad', m === 'insuf');
      bar.classList.toggle('t-good', m === 'suf');
    });
    document.querySelectorAll<HTMLElement>('.sufpct').forEach((p) => (p.textContent = p.dataset[m] || ''));
    setMetric('suf', m);
  });

  const prov = document.getElementById('prov-metric') as HTMLSelectElement | null;
  prov?.addEventListener('change', () => setMetric('prov', prov.value));
</script>
