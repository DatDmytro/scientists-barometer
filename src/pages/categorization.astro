---
import Layout from '../layouts/Layout.astro';
import ViewToggle from '../components/ViewToggle.astro';
import CatCrossTab from '../components/CatCrossTab.astro';
import BlockHeader from '../components/BlockHeader.astro';
import BlockNav from '../components/BlockNav.astro';
import block from '../data/block-categorization-2026.json';
import { i18n } from '../i18n';

const { en, tr, link, num } = i18n(Astro);

const acts = block.activities; // дефолт: за спаданням БД%
const lbl = (n: number) => (n >= 10 ? String(Math.round(n)) : '');
---

<Layout
  title={en ? 'Categorisation of activities — Scientists Barometer' : 'Категоризація діяльності — Науковий Барометр'}
  description={en ? '54 researcher activities classified as actual scientific, useful non-scientific or meaningless.' : '54 види діяльності науковця, класифіковані як дійсна наукова, корисна ненаукова чи безглузда.'}
>
  <BlockHeader slug="categorization" />
  <p class="note">{tr(block.note)} {en ? <>Definitions of ASA, UNSA and MA are on the <a href={link('/about#kategorii')}>About</a> page.</> : <>Визначення ДНД, КННД і БД — на сторінці <a href={link('/about#kategorii')}>«Про проєкт»</a>.</>}</p>

  <div class="cat-summary">
    <div><b>{block.summary['ДНД']}</b>{en ? ' activities: mainly actual scientific' : ' видів — переважно дійсна наукова'}</div>
    <div><b>{block.summary['КННД']}</b>{en ? ': useful non-scientific' : ' — корисна ненаукова'}</div>
    <div><b>{block.summary['БД']}</b>{en ? ': meaningless' : ' — безглузда'}</div>
    <div><b>{num(block.fleissKappa, 3)}</b>{en ? ' Fleiss κ: fair agreement' : ' Fleiss κ — помітна узгодженість'}</div>
    <div><b>{block.controversialCount}</b>{en ? <> contested: gap under 20 pp</> : <> суперечливих — розрив &lt; 20 в.п.</>}</div>
  </div>

  <div class="cat-legend">
    <span><i class="swnd"></i>{en ? 'ASA: actual scientific' : 'ДНД — дійсна наукова'}</span>
    <span><i class="swkn"></i>{en ? 'UNSA: useful non-scientific' : 'КННД — корисна ненаукова'}</span>
    <span><i class="swbd"></i>{en ? 'MA: meaningless' : 'БД — безглузда'}</span>
    <span class="note">{en ? 'Pᵢ: respondents’ agreement on the categorisation of activity i' : 'Pᵢ — узгодженість респондентів щодо категоризації i-того виду'}</span>
  </div>

  <div class="catsort">
    {en ? 'Sort:' : 'Сортувати:'}
    <select id="cat-sort">
      <option value="bd">{en ? 'by meaningless (MA)' : 'за безглуздою (БД)'}</option>
      <option value="nd">{en ? 'by actual scientific (ASA)' : 'за дійсною науковою (ДНД)'}</option>
      <option value="kn">{en ? 'by useful non-scientific (UNSA)' : 'за корисною ненауковою (КННД)'}</option>
      <option value="pi">{en ? 'by agreement (Pᵢ)' : 'за узгодженістю (Pᵢ)'}</option>
    </select>
  </div>

  <ViewToggle id="cat">
    <div slot="chart" id="cat-chart">
      {
        acts.map((a) => (
          <div class="actrow" data-nd={a.nd} data-kn={a.kn} data-bd={a.bd} data-pi={a.pi}>
            <div class="actname">
              {tr(a.name)}
              <span class="pi">Pᵢ={num(a.pi, 2)}</span>
              {a.controversial && <span class="contro">{en ? ' · contested' : ' · суперечливо'}</span>}
            </div>
            <div class="actbar">
              <span class="nd" style={`width:${a.nd}%`} title={en ? `ASA ${num(a.nd)}%` : `ДНД ${num(a.nd)} %`}>{lbl(a.nd)}</span>
              <span class="kn" style={`width:${a.kn}%`} title={en ? `UNSA ${num(a.kn)}%` : `КННД ${num(a.kn)} %`}>{lbl(a.kn)}</span>
              <span class="bd" style={`width:${a.bd}%`} title={en ? `MA ${num(a.bd)}%` : `БД ${num(a.bd)} %`}>{lbl(a.bd)}</span>
            </div>
          </div>
        ))
      }
    </div>
    <table slot="table">
      <thead>
        <tr>
          <th>{en ? 'Activity' : 'Вид діяльності'}</th>
          <th class="num">{en ? 'ASA %' : 'ДНД %'}</th>
          <th class="num">{en ? 'UNSA %' : 'КННД %'}</th>
          <th class="num">{en ? 'MA %' : 'БД %'}</th>
          <th class="num">Pᵢ</th>
          <th class="num">n</th>
        </tr>
      </thead>
      <tbody id="cat-tbody">
        {
          acts.map((a) => (
            <tr data-nd={a.nd} data-kn={a.kn} data-bd={a.bd} data-pi={a.pi}>
              <td>{tr(a.name)}</td>
              <td class="num">{num(a.nd)}</td>
              <td class="num">{num(a.kn)}</td>
              <td class="num" style={a.dominant === 'БД' ? 'font-weight:700' : ''}>
                {num(a.bd)}
              </td>
              <td class="num">{num(a.pi, 3)}</td>
              <td class="num">{a.n}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </ViewToggle>

  <p class="note" style="margin-top:1.5rem">
    {en ? <>The most meaningless practices (according to researchers): printing paper copies, oral and written
    reporting, meeting formal metrics (h-index, citations).</> : <>Найбезглуздіші практики (за версією науковців): друк паперових варіантів, усне й письмове
    звітування, забезпечення формальних метрик (h-індекс, цитування).</>}
  </p>

  <section>
    <h2>{en ? 'Demographic breakdowns' : 'Розрізи за демографією'}</h2>
    <CatCrossTab block={block} />
  </section>

  <section>
    <h2>{en ? 'Comments on this block' : 'Коментарі до блоку'} ({block.comments.length})</h2>
    <p class="note">{en ? 'Respondents’ open comments on this section of the questionnaire, in English translation. The originals are in the Ukrainian version of this page.' : 'Відкриті коментарі респондентів до цього розділу анкети — дослівно, без редагування.'}</p>
    <ul class="qlist comments">
      {block.comments.map((c) => <li>{tr(c)}</li>)}
    </ul>
  </section>

  <BlockNav slug="categorization" where="bottom" />
</Layout>

<script>
  const sel = document.getElementById('cat-sort') as HTMLSelectElement | null;
  const chart = document.getElementById('cat-chart');
  const tbody = document.getElementById('cat-tbody');
  function sortContainer(container: HTMLElement | null, key: string) {
    if (!container) return;
    const rows = Array.from(container.children) as HTMLElement[];
    rows.sort((a, b) => parseFloat(b.dataset[key] || '0') - parseFloat(a.dataset[key] || '0'));
    rows.forEach((r) => container.appendChild(r));
  }
  // Показник теплокарти (ДНД/КННД/БД): числа й кольори всіх трьох уже відрендерені —
  // перемикаємо лише data-metric контейнера, далі все робить CSS.
  function applyMetric(cat: string) {
    document.querySelectorAll<HTMLElement>('[data-metric-root="cat"]').forEach((el) => (el.dataset.metric = cat));
  }

  sel?.addEventListener('change', () => {
    const key = sel.value;
    sortContainer(chart, key);
    sortContainer(tbody, key);
    document.querySelectorAll('.ct-pane tbody').forEach((tb) => sortContainer(tb as HTMLElement, key));
    if (key === 'nd' || key === 'kn' || key === 'bd') applyMetric(key);
  });
</script>
