---
import Layout from '../layouts/Layout.astro';
import BlockHeader from '../components/BlockHeader.astro';
import BlockNav from '../components/BlockNav.astro';
import IndexForest from '../components/IndexForest.astro';
import DistTable from '../components/DistTable.astro';
import MirrorHist from '../components/MirrorHist.astro';
import TimeCrossTab from '../components/TimeCrossTab.astro';
import block from '../data/block-timestructure-2026.json';
import verification from '../data/verification-2026.json';
import { byCode, CHANGE_CAVEAT } from '../lib/indices';
import { num, pct } from '../lib/format';

const sh = Object.fromEntries(block.shares.map((s) => [s.cat, s]));
const h = block.hours;
const CHANGE = [
  { title: 'Час на дійсну наукову діяльність', codes: ['ІНЧ 1', 'ІНЧ 5'] },
  { title: 'Час на корисну ненаукову діяльність', codes: ['ІКННЧ 1', 'ІКННЧ 5'] },
  { title: 'Час на безглузду діяльність', codes: ['ІБВЧ 1', 'ІБВЧ 5'] },
];
const inch5 = byCode('ІНЧ 5');
const ibvch5 = byCode('ІБВЧ 5');
const CAT: Record<string, { label: string; tone: string }> = {
  НД: { label: 'Дійсна наукова (ДНД)', tone: 'good' },
  КН: { label: 'Корисна ненаукова (КННД)', tone: 'neutral' },
  БД: { label: 'Безглузда (БД)', tone: 'bad' },
};
---

<Layout
  title="Структура робочого часу — Науковий Барометр"
  description="Скільки робочого часу науковці витрачають на дійсну наукову, корисну ненаукову та безглузду діяльність."
>
  <BlockHeader slug="time-structure" />

  <section>
    <h2>На що йде робочий час</h2>
    <div class="actbar timebar" role="img" aria-label={`ДНД ${pct(sh['НД'].mean)}, КННД ${pct(sh['КН'].mean)}, БД ${pct(sh['БД'].mean)}`}>
      <span class="nd" style={`width:${sh['НД'].mean}%`}>ДНД {pct(sh['НД'].mean)}</span>
      <span class="kn" style={`width:${sh['КН'].mean}%`}>КННД {pct(sh['КН'].mean)}</span>
      <span class="bd" style={`width:${sh['БД'].mean}%`}>БД {pct(sh['БД'].mean)}</span>
    </div>
    <table>
      <thead>
        <tr><th>Категорія</th><th class="num">Середнє %</th><th class="num">Медіана</th><th class="num">ЗВО</th><th class="num">НУ</th></tr>
      </thead>
      <tbody>
        {block.shares.map((s) => (
          <tr>
            <td>{s.label}</td>
            <td class="num"><b>{num(s.mean)}</b></td>
            <td class="num">{num(s.median)}</td>
            <td class="num">{num(s.zvo)}</td>
            <td class="num">{num(s.nu)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">{block.note}</p>
  </section>

  <section>
    <h2>Скільки реально працюють</h2>
    <div class="cat-summary">
      <div><b>{num(h.mean)}</b> год/тиждень у середньому (медіана {num(h.median)})</div>
      <div><b>{pct(h.overtimePct)}</b> працюють понаднормово (41+ год)</div>
      <div><b>{num(h.bullshitHoursAtMean)}</b> год/тиждень — на безглузду діяльність</div>
    </div>
    <p class="note">
      Законодавча норма в Україні — 40 год/тиждень. Тобто в середньому на <b>безглузду діяльність</b>
      іде понад {num(h.bullshitHoursAtMean)} годин щотижня (а при нормованому тижні — ≈{num(h.bullshitHoursAt40)}).
    </p>
  </section>

  <section id="zvo-nu">
    <h2>ЗВО і наукові установи</h2>
    <p class="note" style="margin-top:-0.2rem">
      Розподіл відповідей про частку часу в закладах вищої освіти й наукових установах (% кожної групи).
      Відмінності перевірено критерієм Манна-Уітні.
    </p>
    <div class="mirrors">
      {verification.knownGroups.map((g) => (
        <MirrorHist title={CAT[g.category].label} bins={g.distribution} zvo={g.zvo} nu={g.nu} delta={g.delta} p={g.p} tone={CAT[g.category].tone} />
      ))}
    </div>
    <p class="note">
      У наукових установах частка дійсної наукової діяльності значно вища, а безглуздої — нижча; за
      корисною ненауковою значущої різниці немає. Як рахувався критерій — у
      <a href="/methodology#nadiinist">методології</a>.
    </p>
  </section>

  <section>
    <h2>Оцінка змін структури часу</h2>
    <p class="note" style="margin-top:-0.2rem">
      Як, на думку респондентів, змінилася частка часу на кожну категорію за рік і за 5 років
      (індекс; 100 — порівну відповідей «зросла» і «скоротилася»). {CHANGE_CAVEAT}
    </p>
    <IndexForest groups={CHANGE} />
    <p class="note">
      За оцінкою респондентів, найшвидше зростав час на <b>безглузду діяльність</b>
      (за 5 років — {num(ibvch5.value)}: {pct(ibvch5.up, 0)} «зросла» проти {pct(ibvch5.down, 0)}
      «скоротилася»). Щодо часу на <b>наукову</b> діяльність думки розділилися: {num(inch5.value)} — це
      {pct(inch5.up, 0)} «зросла» і {pct(inch5.down, 0)} «скоротилася», а не «без змін».
    </p>
    <DistTable codes={CHANGE.flatMap((g) => g.codes)} caption="Розподіл відповідей, %" />
  </section>

  <section>
    <h2>Розрізи за демографією</h2>
    <p class="note" style="margin-top:-0.2rem">
      Середня частка робочого часу на кожну категорію (<span class="t-good">ДНД</span> /
      <span class="t-neutral">КННД</span> / <span class="t-bad">БД</span>) у розрізі груп.
    </p>
    <TimeCrossTab block={block} />
  </section>

  <section>
    <h2>Коментарі до блоку ({block.comments.length})</h2>
    <p class="note">Відкриті коментарі респондентів до цього розділу анкети — дослівно, без редагування.</p>
    <ul class="qlist comments">
      {block.comments.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <BlockNav slug="time-structure" where="bottom" />
</Layout>
