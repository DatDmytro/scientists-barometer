---
import Layout from '../layouts/Layout.astro';
import BlockHeader from '../components/BlockHeader.astro';
import BlockNav from '../components/BlockNav.astro';
import IndexForest from '../components/IndexForest.astro';
import DistTable from '../components/DistTable.astro';
import MirrorHist from '../components/MirrorHist.astro';
import TimeCrossTab from '../components/TimeCrossTab.astro';
import block from '../data/block-timestructure-2026.json';
import verification from '../data/verification-2026.json';
import { indexApi } from '../lib/indices';
import { i18n } from '../i18n';

const { lang, en, tr, link, num, pct, pval, signed } = i18n(Astro);
const { byCode, CHANGE_CAVEAT } = indexApi(lang);

const sh = Object.fromEntries(block.shares.map((s) => [s.cat, s]));
const h = block.hours;
const CHANGE = [
  { title: (en ? 'Time on actual scientific activity' : 'Час на дійсну наукову діяльність'), codes: ['ІНЧ 1', 'ІНЧ 5'] },
  { title: (en ? 'Time on useful non-scientific activity' : 'Час на корисну ненаукову діяльність'), codes: ['ІКННЧ 1', 'ІКННЧ 5'] },
  { title: (en ? 'Time on meaningless activity' : 'Час на безглузду діяльність'), codes: ['ІБВЧ 1', 'ІБВЧ 5'] },
];
const inch5 = byCode('ІНЧ 5');
const ibvch5 = byCode('ІБВЧ 5');
const CAT: Record<string, { label: string; tone: string }> = {
  НД: { label: (en ? 'Actual scientific (ASA)' : 'Дійсна наукова (ДНД)'), tone: 'nd' },
  КН: { label: (en ? 'Useful non-scientific (UNSA)' : 'Корисна ненаукова (КННД)'), tone: 'kn' },
  БД: { label: (en ? 'Meaningless (MA)' : 'Безглузда (БД)'), tone: 'bd' },
};
---

<Layout
  title={en ? 'Working time structure — Scientists Barometer' : 'Структура робочого часу — Науковий Барометр'}
  description={en ? 'How much working time researchers spend on actual scientific, useful non-scientific and meaningless activity.' : 'Скільки робочого часу науковці витрачають на дійсну наукову, корисну ненаукову та безглузду діяльність.'}
>
  <BlockHeader slug="time-structure" />

  <section>
    <h2>{en ? 'Where working time goes' : 'На що йде робочий час'}</h2>
    <p class="note" style="margin-top:-0.2rem">{en ? <>Definitions of ASA, UNSA and MA are on the <a href={link('/about#kategorii')}>About</a> page.</> : <>Визначення ДНД, КННД і БД — на сторінці <a href={link('/about#kategorii')}>«Про проєкт»</a>.</>}</p>
    <div class="actbar timebar" role="img" aria-label={en ? `ASA ${pct(sh['НД'].mean)}, UNSA ${pct(sh['КН'].mean)}, MA ${pct(sh['БД'].mean)}` : `ДНД ${pct(sh['НД'].mean)}, КННД ${pct(sh['КН'].mean)}, БД ${pct(sh['БД'].mean)}`}>
      <span class="nd" style={`width:${sh['НД'].mean}%`}>{en ? 'ASA' : 'ДНД'} {pct(sh['НД'].mean)}</span>
      <span class="kn" style={`width:${sh['КН'].mean}%`}>{en ? 'UNSA' : 'КННД'} {pct(sh['КН'].mean)}</span>
      <span class="bd" style={`width:${sh['БД'].mean}%`}>{en ? 'MA' : 'БД'} {pct(sh['БД'].mean)}</span>
    </div>
    <table>
      <thead>
        <tr><th>{en ? 'Category' : 'Категорія'}</th><th class="num">{en ? 'Mean %' : 'Середнє %'}</th><th class="num">{en ? 'Median' : 'Медіана'}</th><th class="num">{en ? 'HEI' : 'ЗВО'}</th><th class="num">{en ? 'RI' : 'НУ'}</th></tr>
      </thead>
      <tbody>
        {block.shares.map((s) => (
          <tr>
            <td>{tr(s.label)}</td>
            <td class="num"><b>{num(s.mean)}</b></td>
            <td class="num">{num(s.median)}</td>
            <td class="num">{num(s.zvo)}</td>
            <td class="num">{num(s.nu)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">{tr(block.note)}</p>
  </section>

  <section>
    <h2>{en ? 'How much people really work' : 'Скільки реально працюють'}</h2>
    <div class="cat-summary">
      <div><b>{num(h.mean)}</b> {en ? <>hours a week on average (median {num(h.median)})</> : <>год/тиждень у середньому (медіана {num(h.median)})</>}</div>
      <div><b>{pct(h.overtimePct)}</b> {en ? 'work overtime (41+ hours)' : 'працюють понаднормово (41+ год)'}</div>
      <div><b>{num(h.bullshitHoursAtMean)}</b> {en ? 'hours a week on meaningless activity' : 'год/тиждень — на безглузду діяльність'}</div>
    </div>
    <p class="note">
      {en ? <>The statutory norm in Ukraine is 40 hours a week. So on average more than
      {num(h.bullshitHoursAtMean)} hours a week go on <b>meaningless activity</b>.</> : <>Законодавча норма в Україні — 40 год/тиждень. Тобто в середньому на <b>безглузду діяльність</b>
      іде понад {num(h.bullshitHoursAtMean)} годин щотижня.</>}
    </p>
  </section>

  <section id="zvo-nu">
    <h2>{en ? 'Higher education institutions and research institutions' : 'ЗВО і наукові установи'}</h2>
    <p class="note" style="margin-top:-0.2rem">
      {en ? <>Distribution of responses on the share of time in higher education institutions (HEI) and research
      institutions (RI), % of each group. Differences were tested with the Mann–Whitney test.</> : <>Розподіл відповідей про частку часу в закладах вищої освіти й наукових установах (% кожної групи).
      Відмінності перевірено критерієм Манна-Уітні.</>}
    </p>
    <div class="mirrors">
      {verification.knownGroups.map((g) => (
        <MirrorHist
          title={CAT[g.category].label}
          sub={en ? `difference in means ${signed(g.delta)} pp · p = ${pval(g.p)}${g.p >= 0.05 ? ' (n.s.)' : ''}` : `різниця середніх ${signed(g.delta)} в.п. · p = ${pval(g.p)}${g.p >= 0.05 ? ' (н/з)' : ''}`}
          bins={g.distribution.map((d) => ({ label: d.interval, left: d.zvo, right: d.nu }))}
          left={{ label: en ? 'HEI' : 'ЗВО', n: g.zvo.n }}
          right={{ label: en ? 'RI' : 'НУ', n: g.nu.n }}
          head={en ? [`HEI · ${pct(g.zvo.mean)}`, `RI · ${pct(g.nu.mean)}`] : [`ЗВО · ${num(g.zvo.mean)} %`, `НУ · ${num(g.nu.mean)} %`]}
          foot={en ? `median: HEI ${pct(g.zvo.median, 0)}, RI ${pct(g.nu.median, 0)} · n = ${g.zvo.n} / ${g.nu.n}` : `медіана: ЗВО ${num(g.zvo.median, 0)} %, НУ ${num(g.nu.median, 0)} % · n = ${g.zvo.n} / ${g.nu.n}`}
          tone={CAT[g.category].tone}
        />
      ))}
    </div>
    <p class="note">
      {en ? <>In research institutions the share of actual scientific activity is substantially higher and the share
      of meaningless activity lower; for useful non-scientific activity there is no significant difference.
      How the test was computed: see the <a href={link('/methodology#nadiinist')}>methodology</a>.</> : <>У наукових установах частка дійсної наукової діяльності значно вища, а безглуздої — нижча; за
      корисною ненауковою значущої різниці немає. Як рахувався критерій — у
      <a href={link('/methodology#nadiinist')}>методології</a>.</>}
    </p>
  </section>

  <section>
    <h2>{en ? 'Assessed change in time structure' : 'Оцінка змін структури часу'}</h2>
    <p class="note" style="margin-top:-0.2rem">
      {en ? <>How, in respondents’ view, the share of time on each category has changed over 1 year and 5 years
      (index; 100 is the neutral value). {CHANGE_CAVEAT}</> : <>Як, на думку респондентів, змінилася частка часу на кожну категорію за рік і за 5 років
      (індекс; 100 — нейтральне значення). {CHANGE_CAVEAT}</>}
    </p>
    <IndexForest groups={CHANGE} />
    <DistTable codes={CHANGE.flatMap((g) => g.codes)} caption={en ? 'Response distribution, %' : 'Розподіл відповідей, %'} />
  </section>

  <section>
    <h2>{en ? 'Demographic breakdowns' : 'Розрізи за демографією'}</h2>
    <p class="note" style="margin-top:-0.2rem">
      {en ? <>Mean share of working time on each category (<i class="tt-sw swnd"></i> ASA /
      <i class="tt-sw swkn"></i> UNSA / <i class="tt-sw swbd"></i> MA), by group.</> : <>Середня частка робочого часу на кожну категорію (<i class="tt-sw swnd"></i> ДНД /
      <i class="tt-sw swkn"></i> КННД / <i class="tt-sw swbd"></i> БД) у розрізі груп.</>}
    </p>
    <TimeCrossTab block={block} />
  </section>

  <section>
    <h2>{en ? 'Comments on this block' : 'Коментарі до блоку'} ({block.comments.length})</h2>
    <p class="note">{en ? 'Respondents’ open comments on this section of the questionnaire, in English translation. The originals are in the Ukrainian version of this page.' : 'Відкриті коментарі респондентів до цього розділу анкети — дослівно, без редагування.'}</p>
    <ul class="qlist comments">
      {block.comments.map((c) => <li>{tr(c)}</li>)}
    </ul>
  </section>

  <BlockNav slug="time-structure" where="bottom" />
</Layout>
