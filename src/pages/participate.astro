---
import Layout from '../layouts/Layout.astro';
import { i18n } from '../i18n';

const { en } = i18n(Astro);

const email = 'dmitrymaslov@ukr.net';

// Форми Tally. Запрошення й відгуки — окремо, щоб адреси для запрошень не змішувалися з відгуками.
const FORMS = en ? { join: 'Vpj8by', feedback: 'Eq50vB' } : { join: 'PRD09Q', feedback: '6DexQA' };
const formUrl = (id: string) => `https://tally.so/r/${id}`;
const embedUrl = (id: string) => `https://tally.so/embed/${id}?alignLeft=1&hideTitle=1&transparentBackground=1`;
---

<Layout
  title={en ? 'Take part — Scientists Barometer' : 'Долучитися — Науковий Барометр'}
  description={en ? 'Leave your contact details to take part in the next wave of the survey, or send feedback about the site.' : 'Лишіть контакт, щоб узяти участь у наступній хвилі опитування, або надішліть відгук про сайт.'}
>
  <h1>{en ? 'Take part' : 'Долучитися'}</h1>
  <p class="lead">
    {en ? <>The Barometer is repeated in waves. If you would like to take part in the next survey, leave your
    contact details and we will send you the form when a new wave starts. The survey itself is conducted in
    Ukrainian. You can also send feedback here about the site or the study.</> : <>«Барометр» повторюється хвилями. Якщо хочете взяти участь у наступному опитуванні — лишіть
    контакт, і ми надішлемо вам форму, коли стартує нова хвиля. Тут само можна надіслати відгук про
    сайт чи дослідження.</>}
  </p>

  <div class="cta-grid">
    <div class="cta">
      <h3>{en ? 'Get an invitation to the next wave' : 'Отримати запрошення на наступну хвилю'}</h3>
      <p>
        {en ? <>Leave your address and we will send you the form when a new wave of the survey starts. That is the only
        thing we will use your address for. Your contact details are kept <b>separately</b> from the research
        data and never become part of them.</> : <>Лишіть адресу — і коли стартує нова хвиля опитування, ми надішлемо вам форму. Це єдине, для
        чого ми використаємо вашу адресу. Ваш контакт зберігається <b>окремо</b> від даних дослідження
        і ніколи не стає їх частиною.</>}
      </p>
      <a class="btn" href={formUrl(FORMS.join)} target="_blank" rel="noopener" data-embed={embedUrl(FORMS.join)} data-kind="join">{en ? 'Leave your address' : 'Лишити адресу'}</a>
    </div>

    <div class="cta">
      <h3>{en ? 'Feedback on the site and the study' : "Зворотний зв'язок про сайт і дослідження"}</h3>
      <p>
        {en ? <>Found an error, or have a suggestion or a comment on the methodology? Please write: it helps to
        improve the instrument before the next iteration. Feedback is not part of the study.</> : <>Помітили помилку, маєте пропозицію чи зауваження до методології? Напишіть — це допомагає
        покращити інструмент до наступної ітерації. Відгук не є частиною дослідження.</>}
      </p>
      <a class="btn btn-sec" href={formUrl(FORMS.feedback)} target="_blank" rel="noopener" data-embed={embedUrl(FORMS.feedback)} data-kind="feedback">{en ? 'Write feedback' : 'Написати відгук'}</a>
    </div>
  </div>

  <div class="meta">
    <p><b>{en ? 'How we handle your contact details' : 'Як ми поводимося з вашим контактом'}</b></p>
    <p>{en ? <><b>Who collects them:</b> D. Maslov (ORCID 0000-0002-1721-8319), author of the study.</> : <><b>Хто збирає:</b> Маслов Д.С. (ORCID 0000-0002-1721-8319), автор дослідження.</>}</p>
    <p>{en ? <><b>What:</b> your email address; in the feedback form, your message, and your address only if you wish.</> : <><b>Що:</b> вашу електронну адресу; у формі відгуку — повідомлення, а адресу лише за бажанням.</>}</p>
    <p>{en ? <><b>Why:</b> an address left for an invitation is used solely to send you the survey form at the next wave; an address left with feedback is used only to reply. No mailing lists or advertising.</> : <><b>Навіщо:</b> адресу для запрошення — виключно щоб надіслати форму опитування при наступній хвилі; адресу з відгуку — лише щоб відповісти. Жодної розсилки чи реклами.</>}</p>
    <p>{en ? <><b>Where:</b> the forms run on the Tally service (Belgium, data stored in the EU). The data are not passed to any other third parties. A form loads only after you press the button; while it is open, Tally keeps a technical form identifier in your browser.</> : <><b>Де:</b> форми працюють на сервісі Tally (Бельгія, дані зберігаються в ЄС). Іншим третім сторонам дані не передаються. Форма завантажується лише після натискання кнопки; під час заповнення Tally зберігає у браузері службовий ідентифікатор форми.</>}</p>
    <p>{en ? <><b>How long:</b> until you ask for deletion or until the project ends.</> : <><b>Скільки:</b> до вашого запиту про видалення або до завершення проєкту.</>}</p>
    <p>
      {en ? <><b>Separate from the study:</b> the contact details of those who wish to take part and feedback are not
      research material. They are kept separately from the survey responses, are not published and are not
      part of any aggregated data on this site.</> : <><b>Окремо від дослідження:</b> контакти охочих долучитися й відгуки — це не матеріал
      дослідження. Вони зберігаються окремо від відповідей опитування, не публікуються й не входять у
      жодні агреговані дані на цьому сайті.</>}
    </p>
    <p>
      {en ? <><b>Your rights:</b> access, correction or deletion. Write to</> : <><b>Ваші права:</b> доступ, виправлення чи видалення — напишіть на</>}
      <a href={`mailto:${email}`}>{email}</a>.
    </p>
  </div>
</Layout>

<script>
  // Форма Tally завантажується лише після натискання кнопки, тож решта відвідувачів нічого з Tally не отримує.
  // Без скриптів кнопка просто відкриває форму в новій вкладці.
  document.querySelectorAll<HTMLAnchorElement>('a[data-embed]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = btn.dataset.embed ?? '';
      frame.title = btn.textContent?.trim() ?? '';
      frame.className = `tally-frame ${btn.dataset.kind}`;
      btn.closest('.cta')?.classList.add('open');
      btn.replaceWith(frame);
    });
  });
</script>

<style>
  .cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }
  .cta {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.25rem 1.4rem;
    background: #fff;
  }
  .cta h3 {
    margin: 0 0 0.45rem;
    font-size: 1.05rem;
    color: var(--ink);
  }
  .cta p {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.5;
  }
  .cta b {
    color: var(--ink);
  }
  .btn {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    padding: 0.5rem 1.1rem;
    border-radius: 8px;
  }
  .btn:hover {
    opacity: 0.92;
  }
  .btn-sec {
    background: #fff;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
  .meta a {
    color: var(--accent);
  }
  /* відкрита форма займає всю ширину сітки */
  .cta.open {
    grid-column: 1 / -1;
  }
  @media (max-width: 620px) {
    .cta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
