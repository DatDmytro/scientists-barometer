---
import Layout from '../layouts/Layout.astro';
import CrossTab from '../components/CrossTab.astro';
import BlockHeader from '../components/BlockHeader.astro';
import BlockNav from '../components/BlockNav.astro';
import StatTile from '../components/StatTile.astro';
import block from '../data/block-motivation-2026.json';
import ci from '../data/crosstab-ci-2026.json';
import verification from '../data/verification-2026.json';
import { pct } from '../lib/format';

const maxPct = Math.max(...block.options.map((o) => o.pct));
// змістовність роботи — окреме питання блоку (частка двох позитивних відповідей) + ДІ Вілсона
const ZLABEL = 'Змістовність роботи (% згодних)';
const zmist = ci.indicators.find((i) => i.label === ZLABEL)!;
const zq = (verification.questionnaire.indicators as Record<string, string>)[ZLABEL];
const [zQuestion, zOriginal] = zq.split(' (в оригіналі у Д. Гребера:').map((x) => x.trim());
const graeber = zOriginal?.replace(/[«»()]/g, '').trim();
---

<Layout
  title="Мотивація науковців — Науковий Барометр"
  description="Як науковці бачать головну мету своєї роботи: розподіл відповідей та розрізи за демографією."
>
  <BlockHeader slug="motivation" title="Мотивація науковців" />
  <p class="note">Множинний вибір; відповіли n = {block.n}. Можна обрати кілька варіантів.</p>

  <section>
    <h2>Розподіл відповідей</h2>
    <table class="dist">
      <tbody>
        {block.options.map((o) => (
          <tr>
            <td class="opt">{o.label}</td>
            <td class="barcell"><div class="bar"><span style={`width:${(o.pct / maxPct) * 100}%`}></span></div></td>
            <td class="pct">{pct(o.pct)}</td>
            <td class="nn">{o.n}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">
      Лише <b>{pct(block.options.find((o) => o.code === 'most_papers')!.pct)}</b> обрали «опублікувати більше
      всіх статей» і <b>{pct(block.options.find((o) => o.code === 'hirsch')!.pct)}</b> — «найвищий індекс
      Гірша». Формальні метрики майже ніхто не вважає метою — переважають прикладний і фундаментальний
      результати.
    </p>
  </section>

  <section>
    <h2>Змістовність роботи</h2>
    <div class="tiles" style="max-width:420px">
      <StatTile title="Моя робота робить змістовний внесок у світ" value={zmist.pct} ci={zmist.ci as [number, number]}
                n={zmist.n} question={zQuestion} answer="«повністю» + «скоріше погоджуюсь»" />
    </div>
    {graeber && (
      <p class="note">
        В оригіналі в Девіда Гребера: «{graeber}».
      </p>
    )}
  </section>

  <section>
    <h2>Розрізи за демографією</h2>
    <p class="note" style="margin-top:-0.2rem">
      Обери вимір — побачиш, як частка кожної мети змінюється між групами (теплокарта: темніше = вищий %).
    </p>
    <CrossTab block={block} />
  </section>

  <section>
    <h2>Дописані варіанти мети ({block.writeInCount})</h2>
    <p class="note">
      Власні відповіді респондентів у полі «Інше» — дослівно, без редагування.
    </p>
    <ul class="qlist">
      {block.writeIns.map((wr) => <li>{wr}</li>)}
    </ul>
  </section>

  <section>
    <h2>Коментарі до блоку ({block.comments.length})</h2>
    <p class="note">Відкриті коментарі респондентів до цього розділу анкети — дослівно, без редагування.</p>
    <ul class="qlist comments">
      {block.comments.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <BlockNav slug="motivation" where="bottom" />
</Layout>
