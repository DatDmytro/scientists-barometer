---
import Layout from '../layouts/Layout.astro';
import BlockHeader from '../components/BlockHeader.astro';
import BlockNav from '../components/BlockNav.astro';
import IndexForest from '../components/IndexForest.astro';
import LikertDiverging from '../components/LikertDiverging.astro';
import QualCrossTab from '../components/QualCrossTab.astro';
import block from '../data/block-quality-2026.json';
import { byCode, CHANGE_CAVEAT } from '../lib/indices';
import { num, pct } from '../lib/format';

// розподіли — з блоку (дослівні мітки відповідей); значення й 95 % ДІ — через довідник індексів
const likert = (grp: string) =>
  block.indices
    .filter((i) => i.group === grp)
    .map((i) => {
      const m = byCode(i.code);
      return { label: `${m.subject}${m.horizonText ? ', ' + m.horizonText : ''}`, code: i.code, value: i.value, dist: i.dist };
    });

const link = block.timeQualityLink;
const maxPct = Math.max(...link.options.map((o) => o.pct));
const orn1 = byCode('ІОРН 1');
const own1 = byCode('ІЯНР в1');
const own5 = byCode('ІЯНР в5');
const oth1 = byCode('ІЯНР ч1');
const oth5 = byCode('ІЯНР ч5');
---


<Layout
  title="Якість і очікування — Науковий Барометр"
  description="Як науковці оцінюють якість досліджень (ІЯНР), її динаміку та чого очікують від розвитку науки в Україні (ІОРН)."
>
  <BlockHeader slug="quality" title="Якість наукових результатів та очікування" />
  <p class="note">
    П'ятий блок анкети: зв'язок часу і якості, поточна оцінка якості (власної та чужої), оцінка її
    змін за рік і за 5 років і очікування щодо розвитку науки. Звідси — Індекс якості наукових
    результатів (ІЯНР) та Індекс очікувань розвитку науки (ІОРН).
  </p>

  <section>
    <h2>Зв'язок: час на науку ↔ якість результатів</h2>
    <p class="note" style="margin-top:-0.2rem">
      Окреме питання без розрахунку індексу — як науковці бачать механізм впливу часу на якість
      (n = {link.n}).
    </p>
    <table class="dist">
      <tbody>
        {link.options.map((o) => (
          <tr>
            <td class="opt">{o.label}</td>
            <td class="barcell"><div class="bar"><span style={`width:${(o.pct / maxPct) * 100}%`}></span></div></td>
            <td class="pct">{pct(o.pct)}</td>
            <td class="nn">{o.n}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">
      Абсолютна більшість — <b>{pct(link.directPct)}</b> — бачать <b>прямий зв'язок</b>: більше часу на
      дійсну наукову діяльність означає кращу якість. Це методологічно ключовий результат: якщо час
      на справжню науку витісняється безглуздою діяльністю, від цього прямо страждає якість науки
      (підтримка гіпотези H2).
    </p>
    <h3 style="font-size:0.96rem;margin:1.2rem 0 0.3rem;color:var(--ink)">Дописані варіанти (2)</h3>
    <ul class="qlist">
      {link.writeIns.map((w) => <li>{w}</li>)}
    </ul>
  </section>

  <section>
    <h2>Поточна якість результатів</h2>
    <IndexForest groups={[{ codes: ['ІЯНР в', 'ІЯНР ч'] }]} dist={false} />
    <p class="note" style="margin:0.8rem 0 0.3rem">Розподіл оцінок, % відповідей:</p>
    <LikertDiverging rows={likert('Поточна якість')} />
    <p class="note">
      Обидва індекси помірно позитивні (≈113). Більшість оцінює якість як «нормальну» або «скоріше
      високу». Майже однаковий рівень оцінок власних і чужих досліджень свідчить про відсутність
      систематичного завищення самооцінки.
    </p>
  </section>

  <section>
    <h2>Оцінка змін якості</h2>
    <p class="note" style="margin-top:-0.2rem">{CHANGE_CAVEAT}</p>
    <IndexForest groups={[
      { title: 'Якість власних досліджень', codes: ['ІЯНР в1', 'ІЯНР в5'] },
      { title: 'Якість досліджень інших', codes: ['ІЯНР ч1', 'ІЯНР ч5'] },
    ]} dist={false} />
    <p class="note" style="margin:0.8rem 0 0.3rem">Розподіл оцінок змін, % відповідей:</p>
    <LikertDiverging rows={likert('Динаміка якості')} />
    <p class="note">
      Якість <b>власних</b> досліджень, за оцінкою респондентів, покращувалася (рік {num(own1.value)},
      5 років {num(own5.value)}), а для <b>чужих</b> оцінки від нейтрального значення не відрізняються ({num(oth1.value)} /
      {' '}{num(oth5.value)}: інтервали перетинають 100). Контраст «своє покращується, чуже — ні» може бути
      проявом когнітивного упередження. Оцінки змін спираються на пам'ять респондентів — це обмеження пілоту.
    </p>
  </section>

  <section>
    <h2>Очікування розвитку науки</h2>
    <IndexForest groups={[{ codes: ['ІОРН 1', 'ІОРН 5'] }]} dist={false} />
    <p class="note" style="margin:0.8rem 0 0.3rem">Розподіл очікувань, % відповідей:</p>
    <LikertDiverging rows={likert('Очікування')} />
    <p class="note">
      Обидва індекси очікувань <b>суттєво нижчі за 100</b> (на рік {num(byCode('ІОРН 1').value)}, на 5 років
      {' '}{num(byCode('ІОРН 5').value)}) — загальний структурний песимізм. На найближчий рік погіршення очікують
      {' '}<b>{pct(orn1.down)}</b>. На 5-річному горизонті картина дещо оптимістичніша.
    </p>
  </section>

  <section>
    <h2>Розрізи за демографією</h2>
    <p class="note" style="margin-top:-0.2rem">
      Обери вимір — побачиш значення кожного індексу між групами (теплокарта навколо 100).
    </p>
    <QualCrossTab block={block} />
  </section>

  <section>
    <h2>Коментарі до блоку ({block.comments.length})</h2>
    <p class="note">Відкриті коментарі респондентів до цього розділу анкети — дослівно, без редагування.</p>
    <ul class="qlist comments">
      {block.comments.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <BlockNav slug="quality" where="bottom" />
</Layout>
